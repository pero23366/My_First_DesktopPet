{
  "compilerOptions": {
    /* 目标：现代浏览器，不需要降级语法 */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* 严格模式全开。第一次会报一堆错，那些错都是真问题，别关。 */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,

    /* Vite 负责把 TS 编译成 JS，tsc 只做类型检查，不产出文件 */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* 别名：必须和 vite.config.ts 的 resolve.alias 一一对应。
       两处都要写是因为它们服务不同工具 —— Vite 负责真正的模块解析，
       tsc 只做类型检查，少一处就会出现"编辑器不报错、构建却挂"（或反过来）。 */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./Vue/src/*"],
      "@img/*": ["./image/*"]
    }
  },
  /* TS/ 是原版（对照基准，不许动）；Vue/src 只检查 .ts，
     .vue 的类型检查要 vue-tsc，暂未引入。 */
  "include": ["TS", "Vue/src/**/*.ts", "Vue/src/**/*.d.ts"]
}
