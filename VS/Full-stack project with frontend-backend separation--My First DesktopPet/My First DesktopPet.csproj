<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 项目改名成 My First DesktopPet 之后，VS 自动生成的命名空间是
         My_First_DesktopPet（带下划线），代码里不好看。
         这里手动指定成 PetApi，namespace 更干净，也和程序集名一致。 -->
    <RootNamespace>PetApi</RootNamespace>
    <AssemblyName>PetApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

</Project>
