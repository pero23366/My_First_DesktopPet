<!--
注释只有两个安全的地方可以放：

放在整个 <Window> 标签的上面。

放在 <Window> 标签的里面-->
<!--
    这是最关键的一句,
  它告诉 XAML：
    “我的后台代码是 MainWindow.xaml.cs 
    里的那个 MainWindow 类。-->
<!--xmlns="..." 和 xmlns:x="..."：
    这相当于 C# 里的 using System;-->
<!--Title、Height 等是控制窗口大小、状态的-->
<!--Background="Transparent"：背景色透明。

Topmost="True"：永远保持在所有窗口的最上层-->
<Window x:Class="AI桌宠_V1._0._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI桌宠"
        Width="700" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"><!--
        ResizeMode="NoResize" 是拿来治「铺满屏幕就卡死」的，不是审美选择：
        AllowsTransparency=True 会把窗口变成分层窗口，WPF 只能走软件渲染。
        700×450 时 CPU 还扛得住，一旦被 Aero Snap 贴顶、或者 Win+↑ 拉成全屏，
        每帧要在 CPU 上重绘整块屏幕（还有 DropShadowEffect），界面就冻住了。
        无边框窗口没有标题栏，但拖到屏幕上边缘仍然会被贴顶最大化 —— 所以必须从源头禁掉。
        NoResize 同时关掉最大化框和贴顶最大化；代码里还有一道 StateChanged 兜底。-->

    <Grid>
        <!-- 定义两列：左边放回复框，右边放小沃 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================== 左侧：固定大小的回复框 ================== -->
        <Border Grid.Column="0" 
                x:Name="ReplyBubble" 
                Width="300" Height="340"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFF9E6" BorderBrush="#FFD700" BorderThickness="2" 
                CornerRadius="15" Padding="5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>

            <!-- Grid 只为了叠一个关闭键在右上角（对应网页版气泡的 ✕） -->
            <Grid>
                <!-- ScrollViewer：文字超出范围时显示滚动条 -->
                <ScrollViewer x:Name="ReplyScroll" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0"
                              Padding="7,3">
                    <TextBlock x:Name="ReplyText" TextWrapping="Wrap" FontSize="14" Foreground="#333333"/>
                </ScrollViewer>

                <!-- 右上角两个小键：看历史 / 收起气泡 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,2,4,0">

                    <!-- 历史记录：只读窗口，里面的内容不会进模型上下文 -->
                    <Button x:Name="HistoryButton" Content="↺"
                            Width="20" Height="20" Margin="0,0,4,0"
                            FontSize="12" FontWeight="Bold" Foreground="#5B6478"
                            Background="#EFEFEA" BorderThickness="0" Cursor="Hand"
                            ToolTip="历史记录（不会占用对话上下文）" Click="HistoryButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 收起键：只把气泡藏起来，输入行还在；再发一句话会自动回来 -->
                    <Button x:Name="BubbleCloseButton" Content="✕"
                            Width="20" Height="20"
                            FontSize="10" FontWeight="Bold" Foreground="#8A7742"
                            Background="#F2E3A8" BorderThickness="0" Cursor="Hand"
                            ToolTip="收起对话" Click="BubbleCloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================== 右侧：小沃图片 + 思考气泡 ================== -->
        <Grid Grid.ColumnSpan="2" Margin="281,-12,59,12">
            <!-- 小沃图片 -->
            <Image x:Name="PetImage" Source="/Images/小沃_待机empty.png" 
                   Width="254" Height="275"
                  Stretch="Uniform"
       RenderTransformOrigin="0.5,0.5">
                <!--
                    两个变换而不是一个：
                    Scale 用来做帧间补偿（帧 2、3 是裁剪图，同宽度下会显大），
                    Translate 用来把补偿后的位置挪回原位，否则切换瞬间会"跳"一下。
                    这组数值是从网页版实测的不透明包围盒换算来的，两边保持同一套。
                -->
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="PetOffset" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- 思考气泡 -->
            <Border x:Name="ThinkingBubble" 
                    Visibility="Collapsed" 
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,60,0,0"
                    Background="White" BorderBrush="#333333" BorderThickness="2" 
                    CornerRadius="15" Padding="10,5">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" Opacity="0.3" BlurRadius="5"/>
                </Border.Effect>
                <TextBlock x:Name="ThinkingText" Text="." FontSize="20" FontWeight="Bold" Foreground="#333333"/>
            </Border>
        </Grid>

        <!-- ================== 底部：功能栏（整条可收起） ================== -->
        <StackPanel x:Name="FunctionBar" Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="316,0,0,48">

            <!-- 第一行：聊天/思考 + 设置 + 收起键（▾） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">

                <!-- 模型切换按钮 -->
                <Button x:Name="ModelToggleButton" Content="聊天"
                        Width="80" Height="25"
                        Background="White" Foreground="Black"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        FontSize="12" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 设置按钮 -->
                <Button x:Name="SettingsButton" Content="⚙ 设置"
                        Width="80" Height="25" Margin="6,0,0,0"
                        Background="White" Foreground="#666666"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        FontSize="12" FontWeight="Bold" Cursor="Hand"
                        Click="SettingsButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 收起键：就在设置旁边。收起后只剩它自己（变成 ▴） -->
                <Button x:Name="CollapseButton" Content="▾"
                        Width="22" Height="25" Margin="6,0,0,0"
                        Background="White" Foreground="#6B7185"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        FontSize="11" FontWeight="Bold" Cursor="Hand"
                        ToolTip="收起功能栏" Click="CollapseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 第二行：退出 / 输入框 / 发送 -->
            <StackPanel x:Name="InputRow" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 退出按钮 -->
                <Button x:Name="ExitButton" Content="✕" Width="30" Height="30" Margin="0,0,10,0"
                        Foreground="White" FontSize="12" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Click="ExitButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FF4D4D" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 输入框 -->
                <TextBox x:Name="InputBox" Width="220" Height="30" 
                         VerticalContentAlignment="Center" Padding="5,0" />
                <Button x:Name="SendButton" Content="↑" Width="30" Height="30"
                        Foreground="White" FontSize="16" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Click="SendButton_Click" RenderTransformOrigin="0.522,0.533">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="#4D6BFE" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>